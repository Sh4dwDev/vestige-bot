{
  "name": "evrima-storage",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Dinosaur storage for The Isle: Evrima — Discord bot and UE4SS mod",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty",
    "test": "node test/rcon.test.mjs && node test/bridge.test.mjs && node test/population.test.mjs && node test/admins.test.mjs",
    "verify": "pnpm typecheck && pnpm build && pnpm test",
    "prestart": "npm run build",
    "start": "node --experimental-sqlite --env-file-if-exists=.env dist/index.js",
    "commands": "node --experimental-sqlite --env-file-if-exists=.env dist/deploy-commands.js",
    "deploy": "node scripts/deploy-mod.mjs",
    "deploy:reload": "node scripts/deploy-mod.mjs --reload",
    "log": "node scripts/deploy-mod.mjs --log"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "ssh2-sftp-client": "^12.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ssh2-sftp-client": "^9.0.6",
    "ssh2": "^1.17.0",
    "typescript": "^5.7.2"
  }
}
