# Discord. Commands register to every server the bot has joined, so there is no
# guild ID to set.
DISCORD_TOKEN=
# Optional — derived from the token when blank.
DISCORD_CLIENT_ID=

# Game server RCON. Used only to check who is online and to deliver link codes.
RCON_HOST=
RCON_PORT=8888
RCON_PASSWORD=

# SFTP to the game server.
SFTP_HOST=
SFTP_PORT=22
SFTP_USER=
SFTP_PASSWORD=

# The mod's Saved folder on the game server, e.g.
#   TheIsle/Binaries/Win64/ue4ss/Mods/DinoStorage/Saved
MOD_DIR=

# Sent to anyone who types !discord in game. Leave blank to disable it.
DISCORD_INVITE=

# The config file holding AdminsSteamIDs. WindowsServer is correct even on a
# Linux host: the Windows build runs under Proton, and that is the copy the
# server reads and rewrites.
GAME_INI_PATH=/TheIsle/Saved/Config/WindowsServer/Game.ini

# The game host's control panel, used to perform scheduled restarts — Evrima's
# RCON cannot restart the server itself. All three or none; leave blank and the
# bot still warns players and saves the world, but the host must do the restart.
# PANEL_SERVER_ID is the short id from the panel URL, not the long UUID.
PANEL_URL=
PANEL_API_KEY=
PANEL_SERVER_ID=

DATABASE_FILE=./data/storage.sqlite
LINK_CODE_TTL_MINUTES=10

# Backup database. Everything the bot knows - links, points, purchases, founder
# claims - lives in one SQLite file on the game host, and a wiped data
# directory looks exactly like the bot forgetting everybody. PebbleHost hands
# out a MySQL database alongside the file store; pointing this at it gives that
# data a second home on a different subsystem.
#
# Leave blank and backups are simply off, with a warning at boot.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# The player website API. Blank leaves it off entirely, with no listening
# socket. See docs/API.md for the Discord side of the setup: the redirect URI
# registered there must be exactly WEB_BASE_URL + /auth/callback.
WEB_BASE_URL=
DISCORD_CLIENT_SECRET=
WEB_PORT=8787
# A built front end for the bot to serve. Leave blank to expose only the API.
WEB_APP_DIR=
# Only for a front end hosted on another origin. Scheme and host, comma
# separated. Setting this forces session cookies to SameSite=None, which
# browsers accept only over HTTPS.
WEB_ALLOWED_ORIGINS=
